digraph study {
graph [rankdir=LR, bgcolor="white", nodesep=0.18, ranksep=0.38, pad=0.22, splines=polyline, outputorder=edgesfirst];
graph [label="学习分层（非原文章节号）｜原文全文未取得；依据作者摘要、代码与标准推导整理", labelloc=b, fontsize=11, fontname="Noto Sans CJK SC", fontcolor="#526675"];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=18, margin="0.17,0.12", color="#B5C6D0", fillcolor="white", penwidth=1.2];
edge [arrowhead=none, color="#8AA3B1", penwidth=1.4];
root [label="Task-Aware\nMachine Unlearning\n任务感知机器遗忘", fontsize=22, fillcolor="#19354B", fontcolor="white", color="#19354B"];
b0 [label="第01层\n研究动机与问题", color="#2460A6", fillcolor="#EFF5F8", penwidth=1.8];
root -> b0 [color="#2460A6"];
b0_l0 [label="删除历史训练数据的影响，同时关注预测\n性能与运行成本。", tooltip="三个问题依次是：怎样删、怎样减轻预测性能损失、怎样控制下游运行代价。"];
b0 -> b0_l0 [color="#2460A6"];
b1 [label="第02层\n数据与预测模型", color="#167D8D", fillcolor="#EFF5F8", penwidth=1.8];
root -> b1 [color="#167D8D"];
b1_l0 [label="原始特征进入预测器；CNN 核心与可更新\n预测头分开。", tooltip="140 是原始编码输入数，64 是学习到的隐藏维度，14 是预测输出数。"];
b1 -> b1_l0 [color="#167D8D"];
b2 [label="第03层\n直接遗忘与影响函数", color="#8C5A19", fillcolor="#EFF5F8", penwidth=1.8];
root -> b2 [color="#8C5A19"];
b2_l0 [label="用剩余集 Newton 更新删除影响；用影响\n函数估计局部作用。", tooltip="增权与删除符号相反；直接删除中 H_R 与 H_D 不能随意互换。"];
b2 -> b2_l0 [color="#8C5A19"];
b3 [label="第04层\nPAMU：性能感知重加权", color="#5F52A3", fillcolor="#EFF5F8", penwidth=1.8];
root -> b3 [color="#5F52A3"];
b3_l0 [label="根据 MSE/MAPE 的局部影响，为剩余训练\n样本选择权重。", tooltip="调权看 MSE/MAPE，拟合仍用 MSE；样本权重 w 不等于模型参数 θ。"];
b3 -> b3_l0 [color="#5F52A3"];
b4 [label="第05层\n下游任务：两阶段电网成本", color="#1D7562", fillcolor="#EFF5F8", penwidth=1.8];
root -> b4 [color="#1D7562"];
b4_l0 [label="预测决定阶段一发电；真实负荷与已排发\n电决定阶段二费用。", tooltip="同样 MSE 可以造成不同调度费用；人工输入扰动时真实负荷固定。"];
b4 -> b4_l0 [color="#1D7562"];
b5 [label="第06层\nTAMU：成本梯度与调权", color="#B2533B", fillcolor="#EFF5F8", penwidth=1.8];
root -> b5 [color="#B2533B"];
b5_l0 [label="以完整 Cost 梯度替换性能梯度，其余评\n分和重加权框架相连。", tooltip="Cost 梯度指导选权；训练 Hessian 来自 MSE；平均目标不保证逐场景经济性。"];
b5 -> b5_l0 [color="#B2533B"];
b6 [label="第07层\n实验与证据分层", color="#7856A0", fillcolor="#EFF5F8", penwidth=1.8];
root -> b6 [color="#7856A0"];
b6_l0 [label="作者研究范围、仓库复现、你的温度扩展\n具有不同证据来源。", tooltip="实验一打通输入路径；实验二检查节点贡献和多日期稳定性。"];
b6 -> b6_l0 [color="#7856A0"];
b7 [label="第08层\n结论、局限与后续", color="#526675", fillcolor="#EFF5F8", penwidth=1.8];
root -> b7 [color="#526675"];
b7_l0 [label="遗忘、预测性能、运行经济性和输入敏感\n性需要分别评价。", tooltip="局部优化代理、精确头部拟合、逐场景经济性、认证遗忘是不同层次的结论。"];
b7 -> b7_l0 [color="#526675"];
}
