digraph layers {
graph [rankdir=TB,bgcolor="white",nodesep=.2,ranksep=.24,pad=.2];
node [shape=box,style="rounded,filled",fillcolor="#EFF5F8",color="#167D8D",fontname="Noto Sans CJK SC",fontsize=18,margin=".18,.10"];
edge [color="#526675",penwidth=1.4];
input [label="固定未扰动样本\n(N,1,14,10)"];
conv1 [label="Conv1｜3×3 / stride 1\n(N,8,14,10)｜80参数\n局部特征提取"];
relu1 [label="ReLU 第1次调用\n(N,8,14,10)\n本样本48.66%激活为零"];
conv2 [label="Conv2｜4×4 / stride 2\n(N,8,7,5)｜1032参数\n局部感受野扩为6×6编码位置"];
relu2 [label="ReLU 第2次调用\n(N,8,7,5)\n本样本33.93%激活为零"];
flatten [label="Flatten\n(N,8,7,5) → (N,280)\n只重排，不学习新特征"];
lin1 [label="全连接 lin1｜280→64\n(N,64)｜17984参数\n融合所有卷积位置"];
tanh [label="Tanh 隐藏表示 h\n(N,64)｜限制到(-1,1)\n本样本没有 |h|>0.95 的单元"];
head [label="仿射预测头｜64→14\n(N,14)｜910参数\n原始/直接遗忘/重拟合/TAMU 各有一组参数"];
output [label="14节点预测\n反标准化 × baseMVA → MW"];
input -> conv1 -> relu1 -> conv2 -> relu2 -> flatten -> lin1 -> tanh -> head -> output;
subgraph cluster_core {label="四模型共享且冻结的核心：内部激活相同";fontname="Noto Sans CJK SC";fontsize=16;color="#167D8D";style=dashed;conv1;relu1;conv2;relu2;flatten;lin1;tanh;}
head [fillcolor="#F5E9E5",color="#B2533B"];
graph [label="模型内部模块路径｜Captum层归因 + 内部通道/神经元置零｜固定单样本；不解释为物理因果",labelloc=b,fontname="Noto Sans CJK SC",fontsize=11];}
